# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your__api_key_here

# Optional: override the Gemini model used by /api/analyze (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Supabase (optional) ---
# When SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set, the app uses Supabase
# as its provider/category data store (seeded automatically on first use).
# When unset, an embedded in-memory data store is used instead.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
