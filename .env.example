# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your__api_key_here

# Optional: override the Gemini model used by /api/analyze (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: timeouts (ms) so /api/analyze can never hang.
# Gemini request timeout (default 50000). Supabase request timeout (default 10000).
# Hard ceiling for the whole /api/analyze handler, below the 60s platform limit (default 58000).
# GEMINI_TIMEOUT_MS=50000
# SUPABASE_TIMEOUT_MS=10000
# ANALYZE_TIMEOUT_MS=58000

# --- Supabase (optional) ---
# When NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are set, the app uses
# Supabase for authentication and user data (workspace sync, favorites, etc.).
# The provider/category store also switches to Supabase when SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are set (seeded automatically on first use). When unset,
# the embedded in-memory data store is used instead.
#
# Get these from your Supabase project: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: alias for the provider store when NEXT_PUBLIC_SUPABASE_URL is not set
# SUPABASE_URL=

# --- Auth ---
# Public site URL used for auth redirects (email confirmations, OAuth callbacks).
# Required for email verification links to work in production.
NEXT_PUBLIC_SITE_URL=https://www.stack2set.me/
